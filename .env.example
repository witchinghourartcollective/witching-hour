# Witching Hour local environment template
# Copy this file to .env.local and fill only the values needed for your task.
# Never commit .env.local, real API tokens, passwords, or production secrets.

# Public mint configuration; NEXT_PUBLIC_* values are exposed to browsers.
NEXT_PUBLIC_GENESIS_MINT_LIVE=false
NEXT_PUBLIC_GENESIS_MINT_URL=

# Optional local-only script token for `npm run supermemory -- "..."`.
SUPERMEMORY_API_KEY=

# Optional test login credentials for local API smoke testing only.
TEST_LOGIN_EMAIL=
TEST_LOGIN_PASSWORD=

# Optional Upstash QStash settings for queue publishing/receiving.
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=

# Optional Upstash Redis settings for server-side integrations.
REDIS_URL=
REDIS_TOKEN=
